    },
    "staleness": {
      "based_only_on": "actual_mutation",
      "before_first_actual_mutation": "invalid_or_diagnostic_only",
      "counts_invalid_visible_l2_mutations": true,
      "formula": "max(0, t - last_actual_mutation_time_for_same_token_at_or_before_t)",
      "name": "book_staleness_seconds",
      "ranking_eligible": false,
      "unit": "seconds"
    },
    "symbols": {
      "ask_depth_K": "D^a_K = sum_{i=1..K} A_i",
      "ask_levels": "(a_i, A_i) for i=1..5, prices ascending",
      "bid_depth_K": "D^b_K = sum_{i=1..K} B_i",
      "bid_levels": "(b_i, B_i) for i=1..5, prices descending",
      "mid": "m = (b_1 + a_1) / 2",
      "side_share": "p^x_i = q^x_i / Q^x",
      "side_total": "Q^x = sum_{i=1..5} q^x_i",
      "spread": "s = a_1 - b_1"
    },
    "tick_size_policy": {
      "accepted_ticks": [
        0.01,
        0.001
      ],
      "accepted_transition": "explicit_exact_token_level_0.01_to_0.001_change_accepted_by_canonical_validation",
      "default_tick": 0.01,
      "implicit_tick_inference_allowed": false,
      "token_level_transition_required_for_0_001": true,
      "runtime_type": "Decimal",
      "accepted_tick_runtime_values": [
