        "tick_only",
        "noop",
        "parse_failure"
      ],
      "formula": "count(actual_mutation_time_for_same_token in (t-30s, t]) / 30",
      "name": "book_update_intensity",
      "ranking_eligible": false,
      "unit": "mutations_per_second",
      "window": "(t-30s, t]",
      "window_seconds": 30
    },
