        "formula": "B_1 + A_1",
        "name": "top_level_depth",
        "ranking_eligible": true,
        "scope": "best_bid_plus_best_ask_quantity_only"
      },
      {
        "formula": "top 5 sizes padded zero; x=(0,.25,.5,.75,1); per-side p_i=q_i/Q; g_x=2*sum(x_i*p_i)-1; factor=(g_bid+g_ask)/2",
        "name": "depth_slope",
        "ranking_eligible": true,
        "scope": "top_5_depth_shape_from_reconstructed_local_l2"
      },
      {
        "formula": "(bid1_depth/sum_bid_top5 + ask1_depth/sum_ask_top5)/2",
        "name": "depth_concentration",
        "ranking_eligible": true,
        "scope": "two_side_average_top_level_share_from_reconstructed_local_l2"
      },
      {
        "formula": "(c_bid-c_ask)/(c_bid+c_ask), where c_side=top1_depth/sum_side_top5",
        "name": "bid_ask_liquidity_asymmetry",
        "ranking_eligible": true,
        "scope": "bid_vs_ask_top_level_concentration_asymmetry_from_reconstructed_local_l2"
      },
      {
        "formula": "min(m, 1 - m)",
        "name": "distance_to_zero_one",
        "ranking_eligible": true,
        "scope": "distance_from_mid_to_payout_boundaries"
      },
      {
        "formula": "categorical {0.01, 0.001}; default 0.01 unless explicit token-level 0.01->0.001 transition is validated",
